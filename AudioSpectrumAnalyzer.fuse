        LINKID_DataType = "Image",
        LINK_Main = 1,
        INP_Required = false,
    })

    OutImage = self:AddOutput("Output", "Output", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })
end

function OnAddToFlow()
    if self.Comp then
        local ok, prefs = pcall(function() return self.Comp:GetPrefs("Comp.FrameFormat") end)
        if ok and prefs and prefs.Rate and prefs.Rate > 0 then
            InFPS:SetSource(Number(prefs.Rate), 0)
        end
    end
end

function NotifyChanged(inp, param, time)
end

--------------------------------------------------------------------------------
-- Rendering Functions
--------------------------------------------------------------------------------
local function get_side_extents(val, max_h, side_mode, min_h)
    if side_mode == 0 then
        return 0.0, math.max(val * max_h, min_h)
    elseif side_mode == 1 then
        return -math.max(val * max_h, min_h), 0.0
    else
        local hh = math.max(val * max_h * 0.5, min_h * 0.5)
        return -hh, hh
    end
end

local function render_grid(out, style, cx, cy, sx, sy, ex, ey, ux, uy, nx, ny, gh, side_mode, inner_r, rot_rad, arc_rad, grid_opacity, quality)
    if grid_opacity <= 0.001 then
        return
    end
    local grid_shape = Shape()
    local stroke_w = 0.0012

    if style == 5 or style == 6 then
        local max_r = gh * 0.5
        local rings = { inner_r, inner_r + max_r * 0.5, inner_r + max_r }
        local segs = 72
        for _, r in ipairs(rings) do
            for s = 0, segs do
                local ang = rot_rad + (s / segs) * arc_rad
                local px = cx + r * math.cos(ang)
                local py = cy + r * math.sin(ang)
                if s == 0 then
                    grid_shape:MoveTo(px, py)
                else
                    grid_shape:LineTo(px, py)
                end
            end
        end
    else
        local h_min, h_max
        if side_mode == 0 then
            h_min, h_max = 0.0, gh
        elseif side_mode == 1 then
            h_min, h_max = -gh, 0.0
        else
            h_min, h_max = -gh * 0.5, gh * 0.5
        end
        local divs = 4
        for i = 0, divs do
            local h = lerp(h_min, h_max, i / divs)
            grid_shape:MoveTo(sx + nx * h, sy + ny * h)
            grid_shape:LineTo(ex + nx * h, ey + ny * h)
        end
        local vdivs = 8
        for i = 0, vdivs do
            local t = i / vdivs
            local bx = lerp(sx, ex, t)
            local by = lerp(sy, ey, t)
            grid_shape:MoveTo(bx + nx * h_min, by + ny * h_min)
            grid_shape:LineTo(bx + nx * h_max, by + ny * h_max)
        end
    end

    local outlined = grid_shape:OutlineOfShape(stroke_w, "OLT_Solid")
    draw_shape(out, outlined, 0.85, 0.9, 1.0, grid_opacity * 0.65, quality)
end

local function render_spectrum(out, levels, peaks, opts)
    local aspect = (out.Height * out.YScale) / (out.Width * out.XScale)
    local quality = opts.quick and 4 or 8

    local gh = opts.graph_h * aspect
    local sx, sy, ex, ey, cx, cy, gw, ux, uy, nx, ny
    if opts.placement_mode == 0 then
        sx = opts.start_x
        sy = opts.start_y * aspect
        ex = opts.end_x
        ey = opts.end_y * aspect
        local dx = ex - sx
        local dy = ey - sy
        local dist = math.sqrt(dx * dx + dy * dy)
        if dist < 1e-4 then
            dx, dy, dist = 0.01, 0.0, 0.01
            ex = sx + 0.01
        end
        ux, uy = dx / dist, dy / dist
        nx, ny = -uy, ux
        cx = (sx + ex) * 0.5
        cy = (sy + ey) * 0.5
        gw = dist
    else
        cx = opts.center_x
        cy = opts.center_y * aspect
        gw = opts.graph_w
        sx = cx - gw * 0.5
        sy = cy
        ex = cx + gw * 0.5
        ey = cy
        ux, uy = 1.0, 0.0
        nx, ny = 0.0, 1.0
    end

    local side_mode = opts.side_mode
    local max_h = gh
    local rot_rad = (opts.rotation * math.pi) / 180.0
    local arc_rad = (math.max(30.0, math.min(360.0, opts.arc_sweep)) * math.pi) / 180.0

    -- Optional tinted backdrop
    if opts.bg_opacity > 0.001 then
        local bg_shape = Shape()
        add_rect_to_shape(bg_shape, -0.01, -0.01, 1.01, aspect + 0.01)
        draw_shape(out, bg_shape, opts.bg.R, opts.bg.G, opts.bg.B, opts.bg.A * opts.bg_opacity, 4)
    end

    -- Optional Grid & Baseline
    if opts.show_grid then
        render_grid(out, opts.style, cx, cy, sx, sy, ex, ey, ux, uy, nx, ny, gh, side_mode, opts.inner_r, rot_rad, arc_rad, opts.grid_opacity, quality)
    end

    local num_bands = #levels
    local style = opts.style
    local color_mode = opts.color_mode
    local c1, c2, c3, c_peak = opts.c1, opts.c2, opts.c3, opts.c_peak
    local opacity = opts.opacity
    local halo = opts.halo
    local gap = opts.bar_gap
    local line_w = opts.line_w
    local round_caps = opts.round_caps
    local hue_interp = opts.hue_interp

    ----------------------------------------------------------------------------
    -- Style 0: Digital (AE Bars)
    ----------------------------------------------------------------------------
    if style == 0 then
        local slot_w = gw / num_bands
        local half_w = math.max(0.0005, slot_w * (1.0 - gap) * 0.5)
        local min_h = 0.0015 * aspect
        local buckets = math.min(num_bands, 24)
        local core_shapes = {}
        local glow_inner = (halo > 0.01) and {} or nil
        local glow_outer = (halo > 0.01) and {} or nil
        for k = 1, buckets do
            core_shapes[k] = Shape()
            if glow_inner then
                glow_inner[k] = Shape()
                glow_outer[k] = Shape()
            end
        end

        for i = 1, num_bands do
            local t_pos = (i - 0.5) / num_bands
            local t_freq = (num_bands > 1) and ((i - 1) / (num_bands - 1)) or 0.0
            local t_color = (color_mode == 2) and levels[i] or t_freq
            local b_idx = math.max(1, math.min(buckets, math.floor(t_color * (buckets - 1) + 0.5) + 1))

            local bx = lerp(sx, ex, t_pos)
            local by = lerp(sy, ey, t_pos)
            local h_neg, h_pos = get_side_extents(levels[i], max_h, side_mode, min_h)
            add_oriented_bar_to_shape(core_shapes[b_idx], bx, by, ux, uy, nx, ny, half_w, h_neg, h_pos, round_caps)

            if glow_inner then
                local pad1 = half_w * (0.45 + 0.55 * halo)
                local pad2 = half_w * (0.95 + 1.35 * halo)
                local gn1 = (h_neg < 0) and (h_neg - pad1) or 0.0
                local gp1 = (h_pos > 0) and (h_pos + pad1) or 0.0
                local gn2 = (h_neg < 0) and (h_neg - pad2) or 0.0
                local gp2 = (h_pos > 0) and (h_pos + pad2) or 0.0
                add_oriented_bar_to_shape(glow_inner[b_idx], bx, by, ux, uy, nx, ny, half_w + pad1, gn1, gp1, round_caps)
                add_oriented_bar_to_shape(glow_outer[b_idx], bx, by, ux, uy, nx, ny, half_w + pad2, gn2, gp2, round_caps)
            end
        end

        for k = 1, buckets do
            local tk = (buckets > 1) and ((k - 1) / (buckets - 1)) or 0.0
            local r, g, b, a = get_band_color(tk, color_mode, c1, c2, c3, opacity, hue_interp)
            if glow_inner then
                local gr, gg, gb, ga = r, g, b, a
                if color_mode == 0 then
                    gr, gg, gb = shift_hue(c3.R, c3.G, c3.B, tk * hue_interp)
                    ga = c3.A * opacity
                end
                draw_shape(out, glow_outer[k], gr, gg, gb, ga * 0.14 * halo, quality)
                draw_shape(out, glow_inner[k], gr, gg, gb, ga * 0.32 * halo, quality)
            end
            draw_shape(out, core_shapes[k], r, g, b, a, quality)
        end

        if opts.peak_hold then
            local psh = Shape()
            local cap_h = math.max(line_w, 0.002 * aspect)
            for i = 1, num_bands do
                local t_pos = (i - 0.5) / num_bands
                local bx = lerp(sx, ex, t_pos)
                local by = lerp(sy, ey, t_pos)
                local pn, pp = get_side_extents(peaks[i], max_h, side_mode, 0.0)
                if side_mode == 0 or side_mode == 2 then
                    add_oriented_bar_to_shape(psh, bx, by, ux, uy, nx, ny, half_w, pp, pp + cap_h, false)
                end
                if side_mode == 1 or side_mode == 2 then
                    add_oriented_bar_to_shape(psh, bx, by, ux, uy, nx, ny, half_w, pn - cap_h, pn, false)
                end
            end
            draw_shape(out, psh, c_peak.R, c_peak.G, c_peak.B, c_peak.A * opacity, quality)
        end

    ----------------------------------------------------------------------------
    -- Style 1 (Analog Lines) & Style 4 (Filled Area)
    ----------------------------------------------------------------------------
    elseif style == 1 or style == 4 then
        local pts_t = {}
        local pts_h = {}
        for i = 1, num_bands do
            pts_t[i] = (num_bands > 1) and ((i - 1) / (num_bands - 1)) or 0.5
            pts_h[i] = levels[i] * max_h
        end

        local subdiv = 3
        local smooth_t = {}
        local smooth_h = {}
        for i = 1, num_bands - 1 do
            local p0 = pts_h[math.max(1, i - 1)]
            local p1 = pts_h[i]
            local p2 = pts_h[i + 1]
            local p3 = pts_h[math.min(num_bands, i + 2)]
            for s = 0, subdiv - 1 do
                local t = s / subdiv
                smooth_t[#smooth_t + 1] = lerp(pts_t[i], pts_t[i + 1], t)
                local sy_val = sample_catmull_rom(p0, p1, p2, p3, t)
                if sy_val < 0.0 then sy_val = 0.0 end
                if sy_val > max_h then sy_val = max_h end
                smooth_h[#smooth_h + 1] = sy_val
            end
        end
        smooth_t[#smooth_t + 1] = pts_t[num_bands]
        smooth_h[#smooth_h + 1] = pts_h[num_bands]

        local total_pts = #smooth_t
        local buckets = math.min(num_bands, 24)
        for b = 1, buckets do
            local i_start = math.max(1, math.floor(((b - 1) / buckets) * (total_pts - 1)) + 1)
            local i_end = math.min(total_pts, math.floor((b / buckets) * (total_pts - 1)) + 1)
            if i_end > i_start then
                local mid_k = math.floor((i_start + i_end) * 0.5)
                local t_freq = (total_pts > 1) and ((mid_k - 1) / (total_pts - 1)) or 0.0
                local t_color = (color_mode == 2 and max_h > 0) and (smooth_h[mid_k] / max_h) or t_freq
                local r_b, g_b, b_b, a_b = get_band_color(t_color, color_mode, c1, c2, c3, opacity, hue_interp)
                local gr, gg, gb, ga = r_b, g_b, b_b, a_b
                if color_mode == 0 then
                    gr, gg, gb = shift_hue(c3.R, c3.G, c3.B, t_freq * hue_interp)
                    ga = c3.A * opacity
                end

                local scale_side = (side_mode == 2) and 0.5 or 1.0
                if style == 4 then
                    local fill_sh = Shape()
                    if side_mode == 0 or side_mode == 2 then
                        fill_sh:MoveTo(lerp(sx, ex, smooth_t[i_start]), lerp(sy, ey, smooth_t[i_start]))
                        for k = i_start, i_end do
                            local bx = lerp(sx, ex, smooth_t[k])
                            local by = lerp(sy, ey, smooth_t[k])
                            fill_sh:LineTo(bx + nx * smooth_h[k] * scale_side, by + ny * smooth_h[k] * scale_side)
                        end
                        fill_sh:LineTo(lerp(sx, ex, smooth_t[i_end]), lerp(sy, ey, smooth_t[i_end]))
                        fill_sh:Close()
                    end
                    if side_mode == 1 or side_mode == 2 then
                        fill_sh:MoveTo(lerp(sx, ex, smooth_t[i_start]), lerp(sy, ey, smooth_t[i_start]))
                        for k = i_start, i_end do
                            local bx = lerp(sx, ex, smooth_t[k])
                            local by = lerp(sy, ey, smooth_t[k])
                            fill_sh:LineTo(bx - nx * smooth_h[k] * scale_side, by - ny * smooth_h[k] * scale_side)
                        end
                        fill_sh:LineTo(lerp(sx, ex, smooth_t[i_end]), lerp(sy, ey, smooth_t[i_end]))
                        fill_sh:Close()
                    end
                    draw_shape(out, fill_sh, gr, gg, gb, ga * 0.36, quality)
                end

                local seg_sh = Shape()
                if side_mode == 0 or side_mode == 2 then
                    for k = i_start, i_end do
                        local bx = lerp(sx, ex, smooth_t[k])
                        local by = lerp(sy, ey, smooth_t[k])
                        local px = bx + nx * smooth_h[k] * scale_side
                        local py = by + ny * smooth_h[k] * scale_side
                        if k == i_start then seg_sh:MoveTo(px, py) else seg_sh:LineTo(px, py) end
                    end
                end
                if side_mode == 1 or side_mode == 2 then
                    for k = i_start, i_end do
                        local bx = lerp(sx, ex, smooth_t[k])
                        local by = lerp(sy, ey, smooth_t[k])
                        local px = bx - nx * smooth_h[k] * scale_side
                        local py = by - ny * smooth_h[k] * scale_side
                        if k == i_start then seg_sh:MoveTo(px, py) else seg_sh:LineTo(px, py) end
                    end
                end

                if halo > 0.01 then
                    draw_shape(out, seg_sh:OutlineOfShape(line_w * (2.5 + 3.0 * halo), "OLT_Solid"), gr, gg, gb, ga * 0.18 * halo, quality)
                    draw_shape(out, seg_sh:OutlineOfShape(line_w * (1.5 + 1.5 * halo), "OLT_Solid"), gr, gg, gb, ga * 0.35 * halo, quality)
                end
                draw_shape(out, seg_sh:OutlineOfShape(line_w, "OLT_Solid"), r_b, g_b, b_b, a_b, quality)
            end
        end

    ----------------------------------------------------------------------------
    -- Style 2: Analog Dots (AE Classic)
    ----------------------------------------------------------------------------
    elseif style == 2 then
        local dot_r = math.max(line_w * 1.3, 0.0025)
        local buckets = math.min(num_bands, 24)
        local core_shapes = {}
        local glow_shapes = (halo > 0.01) and {} or nil
        for k = 1, buckets do
            core_shapes[k] = Shape()
            if glow_shapes then glow_shapes[k] = Shape() end
        end

        for i = 1, num_bands do
            local t_pos = (num_bands > 1) and ((i - 1) / (num_bands - 1)) or 0.5
            local t_color = (color_mode == 2) and levels[i] or t_pos
            local b_idx = math.max(1, math.min(buckets, math.floor(t_color * (buckets - 1) + 0.5) + 1))

            local bx = lerp(sx, ex, t_pos)
            local by = lerp(sy, ey, t_pos)
            local hn, hp = get_side_extents(levels[i], max_h, side_mode, 0.0)
            if side_mode == 0 or side_mode == 2 then
                local px, py = bx + nx * hp, by + ny * hp
                add_circle_to_shape(core_shapes[b_idx], px, py, dot_r, 12)
                if glow_shapes then add_circle_to_shape(glow_shapes[b_idx], px, py, dot_r * (1.8 + 1.5 * halo), 12) end
            end
            if side_mode == 1 or side_mode == 2 then
                local px, py = bx + nx * hn, by + ny * hn
                add_circle_to_shape(core_shapes[b_idx], px, py, dot_r, 12)
                if glow_shapes then add_circle_to_shape(glow_shapes[b_idx], px, py, dot_r * (1.8 + 1.5 * halo), 12) end
            end
        end

        for k = 1, buckets do
            local tk = (buckets > 1) and ((k - 1) / (buckets - 1)) or 0.0
            local r, g, b, a = get_band_color(tk, color_mode, c1, c2, c3, opacity, hue_interp)
            if glow_shapes then
                local gr, gg, gb, ga = r, g, b, a
                if color_mode == 0 then
                    gr, gg, gb = shift_hue(c3.R, c3.G, c3.B, tk * hue_interp)
                    ga = c3.A * opacity
                end
                draw_shape(out, glow_shapes[k], gr, gg, gb, ga * 0.35 * halo, quality)
            end
            draw_shape(out, core_shapes[k], r, g, b, a, quality)
        end

    ----------------------------------------------------------------------------
    -- Style 3: Segmented LED
    ----------------------------------------------------------------------------
    elseif style == 3 then
        local slot_w = gw / num_bands
        local half_w = math.max(0.0005, slot_w * (1.0 - gap) * 0.5)
        local n_segs = opts.led_segments
        local seg_span = (side_mode == 2) and (max_h * 0.5) or max_h
        local seg_slot = seg_span / n_segs
        local seg_h = seg_slot * 0.72

        if color_mode == 2 then
            local sh_low, sh_mid, sh_high = Shape(), Shape(), Shape()
            for i = 1, num_bands do
                local t_pos = (i - 0.5) / num_bands
                local bx, by = lerp(sx, ex, t_pos), lerp(sy, ey, t_pos)
                local lit = math.floor(levels[i] * n_segs + 0.5)
                for s = 1, lit do
                    local frac = s / n_segs
                    local target = (frac <= 0.60) and sh_low or ((frac <= 0.84) and sh_mid or sh_high)
                    local sy0 = (s - 1) * seg_slot
                    local sy1 = sy0 + seg_h
                    if side_mode == 0 or side_mode == 2 then
                        add_oriented_bar_to_shape(target, bx, by, ux, uy, nx, ny, half_w, sy0, sy1, false)
                    end
                    if side_mode == 1 or side_mode == 2 then
                        add_oriented_bar_to_shape(target, bx, by, ux, uy, nx, ny, half_w, -sy1, -sy0, false)
                    end
                end
            end
            draw_shape(out, sh_low, 0.12, 0.92, 0.42, opacity, quality)
            draw_shape(out, sh_mid, 1.00, 0.82, 0.12, opacity, quality)
            draw_shape(out, sh_high, 1.00, 0.18, 0.25, opacity, quality)
        else
            local buckets = math.min(num_bands, 24)
            local bucket_shapes = {}
            for k = 1, buckets do bucket_shapes[k] = Shape() end
            for i = 1, num_bands do
                local t_pos = (i - 0.5) / num_bands
                local t_freq = (num_bands > 1) and ((i - 1) / (num_bands - 1)) or 0.0
                local b_idx = math.max(1, math.min(buckets, math.floor(t_freq * (buckets - 1) + 0.5) + 1))
                local bx, by = lerp(sx, ex, t_pos), lerp(sy, ey, t_pos)
                local lit = math.floor(levels[i] * n_segs + 0.5)
                for s = 1, lit do
                    local sy0 = (s - 1) * seg_slot
                    local sy1 = sy0 + seg_h
                    if side_mode == 0 or side_mode == 2 then
                        add_oriented_bar_to_shape(bucket_shapes[b_idx], bx, by, ux, uy, nx, ny, half_w, sy0, sy1, false)
                    end
                    if side_mode == 1 or side_mode == 2 then
                        add_oriented_bar_to_shape(bucket_shapes[b_idx], bx, by, ux, uy, nx, ny, half_w, -sy1, -sy0, false)
                    end
                end
            end
            for k = 1, buckets do
                local tk = (buckets > 1) and ((k - 1) / (buckets - 1)) or 0.0
                local r, g, b, a = get_band_color(tk, color_mode, c1, c2, c3, opacity, hue_interp)
                draw_shape(out, bucket_shapes[k], r, g, b, a, quality)
            end
        end

        if opts.peak_hold then
            local psh = Shape()
            for i = 1, num_bands do
                if peaks[i] > 0.005 then
                    local t_pos = (i - 0.5) / num_bands
                    local bx, by = lerp(sx, ex, t_pos), lerp(sy, ey, t_pos)
                    local pk_seg = math.max(1, math.min(n_segs, math.floor(peaks[i] * n_segs + 0.5)))
                    local sy0 = (pk_seg - 1) * seg_slot
                    local sy1 = sy0 + seg_h
                    if side_mode == 0 or side_mode == 2 then
                        add_oriented_bar_to_shape(psh, bx, by, ux, uy, nx, ny, half_w, sy0, sy1, false)
                    end
                    if side_mode == 1 or side_mode == 2 then
                        add_oriented_bar_to_shape(psh, bx, by, ux, uy, nx, ny, half_w, -sy1, -sy0, false)
                    end
                end
            end
            draw_shape(out, psh, c_peak.R, c_peak.G, c_peak.B, c_peak.A * opacity, quality)
        end

    ----------------------------------------------------------------------------
    -- Style 5: Circular Bars (Polar AE Style)
    ----------------------------------------------------------------------------
    elseif style == 5 then
        local base_r = opts.inner_r
        local max_r = gh * 0.5
        local denom_b = (arc_rad < TWO_PI - 0.01 and num_bands > 1) and (num_bands - 1) or num_bands
        local angular_slot = arc_rad / num_bands
        local half_ang = angular_slot * (1.0 - gap) * 0.5
        local buckets = math.min(num_bands, 24)
        local bucket_shapes = {}
        local glow_shapes = (halo > 0.01) and {} or nil
        for k = 1, buckets do
            bucket_shapes[k] = Shape()
            if glow_shapes then glow_shapes[k] = Shape() end
        end

        for i = 1, num_bands do
            local t_freq = (num_bands > 1) and ((i - 1) / (num_bands - 1)) or 0.0
            local t_color = (color_mode == 2) and levels[i] or t_freq
            local b_idx = math.max(1, math.min(buckets, math.floor(t_color * (buckets - 1) + 0.5) + 1))

            local theta = rot_rad + ((i - 1) / denom_b) * arc_rad
            local a0 = theta - half_ang
            local a1 = theta + half_ang
            local c0, s0 = math.cos(a0), math.sin(a0)
            local c1a, s1a = math.cos(a1), math.sin(a1)

            local r_out = base_r
            local r_in = base_r
            if side_mode == 0 then
                r_out = base_r + math.max(levels[i] * max_r, 0.002)
            elseif side_mode == 1 then
                r_in = math.max(0.005, base_r - math.max(levels[i] * max_r * 0.65, 0.002))
            else
                r_out = base_r + math.max(levels[i] * max_r * 0.7, 0.002)
                r_in = math.max(0.005, base_r - math.max(levels[i] * max_r * 0.45, 0.002))
            end

            add_quad_to_shape(
                bucket_shapes[b_idx],
                cx + r_in * c0, cy + r_in * s0,
                cx + r_out * c0, cy + r_out * s0,
                cx + r_out * c1a, cy + r_out * s1a,
                cx + r_in * c1a, cy + r_in * s1a
            )

            if glow_shapes then
                local pad = half_ang * (0.45 + 0.5 * halo)
                local rpad = 0.006 * (0.5 + halo)
                local hc0, hs0 = math.cos(a0 - pad), math.sin(a0 - pad)
                local hc1, hs1 = math.cos(a1 + pad), math.sin(a1 + pad)
                add_quad_to_shape(
                    glow_shapes[b_idx],
                    cx + math.max(0.002, r_in - rpad * 0.5) * hc0, cy + math.max(0.002, r_in - rpad * 0.5) * hs0,
                    cx + (r_out + rpad) * hc0, cy + (r_out + rpad) * hs0,
                    cx + (r_out + rpad) * hc1, cy + (r_out + rpad) * hs1,
                    cx + math.max(0.002, r_in - rpad * 0.5) * hc1, cy + math.max(0.002, r_in - rpad * 0.5) * hs1
                )
            end
        end

        for k = 1, buckets do
            local tk = (buckets > 1) and ((k - 1) / (buckets - 1)) or 0.0
            local r, g, b, a = get_band_color(tk, color_mode, c1, c2, c3, opacity, hue_interp)
            if glow_shapes then
                local gr, gg, gb, ga = r, g, b, a
                if color_mode == 0 then
                    gr, gg, gb = shift_hue(c3.R, c3.G, c3.B, tk * hue_interp)
                    ga = c3.A * opacity
                end
                draw_shape(out, glow_shapes[k], gr, gg, gb, ga * 0.30 * halo, quality)
            end
            draw_shape(out, bucket_shapes[k], r, g, b, a, quality)
        end

        if opts.peak_hold then
            local psh = Shape()
            local cap_r = math.max(line_w, 0.0025)
            for i = 1, num_bands do
                local theta = rot_rad + ((i - 1) / denom_b) * arc_rad
                local a0 = theta - half_ang
                local a1 = theta + half_ang
                local rp0 = base_r + peaks[i] * ((side_mode == 2) and (max_r * 0.7) or max_r)
                local rp1 = rp0 + cap_r
                add_quad_to_shape(
                    psh,
                    cx + rp0 * math.cos(a0), cy + rp0 * math.sin(a0),
                    cx + rp1 * math.cos(a0), cy + rp1 * math.sin(a0),
                    cx + rp1 * math.cos(a1), cy + rp1 * math.sin(a1),
                    cx + rp0 * math.cos(a1), cy + rp0 * math.sin(a1)
                )
            end
            draw_shape(out, psh, c_peak.R, c_peak.G, c_peak.B, c_peak.A * opacity, quality)
        end

    ----------------------------------------------------------------------------
    -- Style 6: Circular Line (Polar AE Style)
    ----------------------------------------------------------------------------
    elseif style == 6 then
        local base_r = opts.inner_r
        local max_r = gh * 0.5
        local is_closed = (arc_rad >= TWO_PI - 0.01)
        local angular_slot = is_closed and (arc_rad / num_bands) or (arc_rad / math.max(1, num_bands - 1))
        local subdiv = 3

        local outer_x, outer_y, outer_val = {}, {}, {}
        local inner_x, inner_y = (side_mode == 1 or side_mode == 2) and {} or nil, (side_mode == 1 or side_mode == 2) and {} or nil

        local seg_count = is_closed and num_bands or (num_bands - 1)
        for i = 1, seg_count do
            local i0 = is_closed and (((i - 2) % num_bands) + 1) or math.max(1, i - 1)
            local i1 = i
            local i2 = is_closed and ((i % num_bands) + 1) or math.min(num_bands, i + 1)
            local i3 = is_closed and (((i + 1) % num_bands) + 1) or math.min(num_bands, i + 2)
            local base_ang = rot_rad + (i - 1) * angular_slot

            for s = 0, subdiv - 1 do
                local t = s / subdiv
                local val = sample_catmull_rom(levels[i0], levels[i1], levels[i2], levels[i3], t)
                if val < 0.0 then val = 0.0 end
                if val > 1.0 then val = 1.0 end
                local ang = base_ang + t * angular_slot
                local ca, sa = math.cos(ang), math.sin(ang)

                local r_out = (side_mode == 1) and base_r or (base_r + val * max_r * ((side_mode == 2) and 0.7 or 1.0))
                outer_x[#outer_x + 1] = cx + r_out * ca
                outer_y[#outer_y + 1] = cy + r_out * sa
                outer_val[#outer_val + 1] = val

                if inner_x then
                    local r_in = math.max(0.005, base_r - val * max_r * 0.45)
                    inner_x[#inner_x + 1] = cx + r_in * ca
                    inner_y[#inner_y + 1] = cy + r_in * sa
                end
            end
        end

        if not is_closed then
            local ang = rot_rad + arc_rad
            local val = levels[num_bands]
            local r_out = (side_mode == 1) and base_r or (base_r + val * max_r * ((side_mode == 2) and 0.7 or 1.0))
            outer_x[#outer_x + 1] = cx + r_out * math.cos(ang)
            outer_y[#outer_y + 1] = cy + r_out * math.sin(ang)
            outer_val[#outer_val + 1] = val
            if inner_x then
                local r_in = math.max(0.005, base_r - val * max_r * 0.45)
                inner_x[#inner_x + 1] = cx + r_in * math.cos(ang)
                inner_y[#inner_y + 1] = cy + r_in * math.sin(ang)
            end
        end

        local total_pts = #outer_x
        if is_closed and total_pts >= 3 then
            local fill_sh = Shape()
            fill_sh:MoveTo(outer_x[1], outer_y[1])
            for k = 2, total_pts do fill_sh:LineTo(outer_x[k], outer_y[k]) end
            fill_sh:Close()
            local r_f, g_f, b_f, a_f = get_band_color(0.35, color_mode, c1, c2, c3, opacity, hue_interp)
            draw_shape(out, fill_sh, r_f, g_f, b_f, a_f * 0.14, quality)
        end

        local buckets = math.min(num_bands, 24)
        for b = 1, buckets do
            local i_start = math.max(1, math.floor(((b - 1) / buckets) * (total_pts - 1)) + 1)
            local i_end = is_closed and math.min(total_pts + 1, math.floor((b / buckets) * total_pts) + 1)
                                    or math.min(total_pts, math.floor((b / buckets) * (total_pts - 1)) + 1)
            if i_end > i_start then
                local mid_k = math.min(total_pts, math.floor((i_start + i_end) * 0.5))
                local t_freq = (total_pts > 1) and ((mid_k - 1) / total_pts) or 0.0
                local t_color = (color_mode == 2) and outer_val[mid_k] or t_freq
                local r_b, g_b, b_b, a_b = get_band_color(t_color, color_mode, c1, c2, c3, opacity, hue_interp)
                local gr, gg, gb, ga = r_b, g_b, b_b, a_b
                if color_mode == 0 then
                    gr, gg, gb = shift_hue(c3.R, c3.G, c3.B, t_freq * hue_interp)
                    ga = c3.A * opacity
                end

                if side_mode ~= 1 then
                    local seg_sh = Shape()
                    seg_sh:MoveTo(outer_x[i_start], outer_y[i_start])
                    for k = i_start + 1, i_end do
                        local kk = is_closed and (((k - 1) % total_pts) + 1) or k
                        seg_sh:LineTo(outer_x[kk], outer_y[kk])
                    end
                    if halo > 0.01 then
                        draw_shape(out, seg_sh:OutlineOfShape(line_w * (2.5 + 3.0 * halo), "OLT_Solid"), gr, gg, gb, ga * 0.18 * halo, quality)
                        draw_shape(out, seg_sh:OutlineOfShape(line_w * (1.5 + 1.5 * halo), "OLT_Solid"), gr, gg, gb, ga * 0.35 * halo, quality)
                    end
                    draw_shape(out, seg_sh:OutlineOfShape(line_w, "OLT_Solid"), r_b, g_b, b_b, a_b, quality)
                end

                if inner_x then
                    local in_seg = Shape()
                    in_seg:MoveTo(inner_x[i_start], inner_y[i_start])
                    for k = i_start + 1, i_end do
                        local kk = is_closed and (((k - 1) % total_pts) + 1) or k
                        in_seg:LineTo(inner_x[kk], inner_y[kk])
                    end
                    if halo > 0.01 then
                        draw_shape(out, in_seg:OutlineOfShape(line_w * (1.5 + 1.5 * halo), "OLT_Solid"), gr, gg, gb, ga * 0.28 * halo, quality)
                    end
                    draw_shape(out, in_seg:OutlineOfShape(line_w, "OLT_Solid"), r_b, g_b, b_b, a_b * 0.85, quality)
                end
            end
        end
    end
end

function Process(req)
    local in_img = InImage:GetValue(req)
    local out_w, out_h, xscale, yscale
    local prefs = nil
    if self.Comp then
        local ok, res = pcall(function() return self.Comp:GetPrefs("Comp.FrameFormat") end)
        if ok then prefs = res end
    end

    if in_img then
        out_w = in_img.Width
        out_h = in_img.Height
        xscale = in_img.XScale
        yscale = in_img.YScale
    else
        local fb_w = math.floor(InOutWidth:GetValue(req).Value + 0.5)
        local fb_h = math.floor(InOutHeight:GetValue(req).Value + 0.5)
        out_w = (prefs and prefs.Width) or fb_w
        out_h = (prefs and prefs.Height) or fb_h
        xscale = (prefs and prefs.XAspect) or 1.0
        yscale = (prefs and prefs.YAspect) or 1.0
        if req:IsQuick() then
            out_w = math.max(64, math.floor(out_w * 0.5))
            out_h = math.max(64, math.floor(out_h * 0.5))
        end
    end

    if req:IsPreCalc() then
        local pre_out = Image({
            IMG_Document = self.Comp,
            IMG_Width = out_w,
            IMG_Height = out_h,
            IMG_XScale = xscale,
            IMG_YScale = yscale,
            IMG_NoData = true,
        })
        OutImage:Set(req, pre_out)
        return
    end

    local composite = (InComposite:GetValue(req).Value > 0.5)
    local out
    if in_img and composite then
        out = in_img:CopyOf()
    elseif in_img then
        out = Image({ IMG_Like = in_img })
        out:Fill(Pixel({ R = 0, G = 0, B = 0, A = 0 }))
    else
        out = Image({
            IMG_Document = self.Comp,
            IMG_Width = out_w,
            IMG_Height = out_h,
            IMG_XScale = xscale,
            IMG_YScale = yscale,
            { IMG_Channel = "Red" },
            { IMG_Channel = "Green" },
            { IMG_Channel = "Blue" },
            { IMG_Channel = "Alpha" },
        })
        out:Fill(Pixel({ R = 0, G = 0, B = 0, A = 0 }))
    end

    local filepath = InAudioFile:GetValue(req).Value
    local num_bands = math.max(8, math.min(128, math.floor(InBands:GetValue(req).Value + 0.5)))
    local fft_idx = math.floor(InFFTSize:GetValue(req).Value + 0.5)
    local fft_sizes = { [0] = 1024, [1] = 2048, [2] = 4096, [3] = 8192 }
    local fft_size = fft_sizes[fft_idx] or 4096

    local auto_fps = (InAutoFPS:GetValue(req).Value > 0.5)
    local manual_fps = InFPS:GetValue(req).Value
    local eff_fps = (auto_fps and prefs and prefs.Rate and prefs.Rate > 0) and prefs.Rate or manual_fps

    local peak_hold = (InPeakHold:GetValue(req).Value > 0.5)
    local params = {
        fft_size = fft_size,
        window_type = math.floor(InWindowType:GetValue(req).Value + 0.5),
        freq_scale = math.floor(InFreqScale:GetValue(req).Value + 0.5),
        fps = math.max(1.0, eff_fps),
        audio_offset = InAudioOffset:GetValue(req).Value,
        channel_mode = math.floor(InChannel:GetValue(req).Value + 0.5),
        min_freq = InMinFreq:GetValue(req).Value,
        max_freq = InMaxFreq:GetValue(req).Value,
        num_bands = num_bands,
        gain_db = InGainDB:GetValue(req).Value,
        floor_db = InFloorDB:GetValue(req).Value,
        slope_db = InSlope:GetValue(req).Value,
        attack = InAttack:GetValue(req).Value,
        release = InRelease:GetValue(req).Value,
        peak_decay = InPeakDecay:GetValue(req).Value,
        peak_hold = peak_hold,
    }

    local levels = {}
    local peaks = {}
    for b = 1, num_bands do
        levels[b] = 0.0
        peaks[b] = 0.0
    end

    local wav, wav_err = parse_wav_header(filepath)
    if wav then
        levels, peaks = compute_smoothed_spectrum(wav, math.floor(req.Time + 0.5), params)
    elseif filepath and filepath ~= "" and wav_err then
        print("[AudioSpectrumAnalyzer] " .. tostring(wav_err) .. " (" .. tostring(filepath) .. ")")
    end

    local start_pt = InStartPoint:GetValue(req)
    local end_pt = InEndPoint:GetValue(req)
    local center = InCenter:GetValue(req)
    local opts = {
        quick = req:IsQuick(),
        style = math.floor(InStyle:GetValue(req).Value + 0.5),
        side_mode = math.floor(InSideOptions:GetValue(req).Value + 0.5),
        peak_hold = peak_hold,
        placement_mode = math.floor(InPlacementMode:GetValue(req).Value + 0.5),
        start_x = start_pt.X,
        start_y = start_pt.Y,
        end_x = end_pt.X,
        end_y = end_pt.Y,
        center_x = center.X,
        center_y = center.Y,
        graph_w = InGraphWidth:GetValue(req).Value,
        graph_h = InGraphHeight:GetValue(req).Value,
        bar_gap = InBarGap:GetValue(req).Value,
        line_w = InLineWidth:GetValue(req).Value,
        round_caps = (InRoundCaps:GetValue(req).Value > 0.5),
        inner_r = InInnerRadius:GetValue(req).Value,
        rotation = InRotation:GetValue(req).Value,
        arc_sweep = InArcSweep:GetValue(req).Value,
        show_grid = (InShowGrid:GetValue(req).Value > 0.5),
        grid_opacity = InGridOpacity:GetValue(req).Value,
        bg_opacity = InBgOpacity:GetValue(req).Value,
        bg = {
            R = InBgR:GetValue(req).Value,
            G = InBgG:GetValue(req).Value,
            B = InBgB:GetValue(req).Value,
            A = InBgA:GetValue(req).Value,
        },
        color_mode = math.floor(InColorMode:GetValue(req).Value + 0.5),
        c1 = {
            R = InColor1R:GetValue(req).Value,
            G = InColor1G:GetValue(req).Value,
            B = InColor1B:GetValue(req).Value,
            A = InColor1A:GetValue(req).Value,
        },
        c2 = {
            R = InColor2R:GetValue(req).Value,
            G = InColor2G:GetValue(req).Value,
            B = InColor2B:GetValue(req).Value,
            A = InColor2A:GetValue(req).Value,
        },
        c3 = {
            R = InColor3R:GetValue(req).Value,
            G = InColor3G:GetValue(req).Value,
            B = InColor3B:GetValue(req).Value,
            A = InColor3A:GetValue(req).Value,
        },
        c_peak = {
            R = InPeakR:GetValue(req).Value,
            G = InPeakG:GetValue(req).Value,
            B = InPeakB:GetValue(req).Value,
            A = InPeakA:GetValue(req).Value,
        },
        hue_interp = InHueInterp:GetValue(req).Value,
        led_segments = math.max(4, math.min(48, math.floor(InLedSegments:GetValue(req).Value + 0.5))),
        halo = InHaloGlow:GetValue(req).Value,
        opacity = InSpectrumOpacity:GetValue(req).Value,
    }

    render_spectrum(out, levels, peaks, opts)
    OutImage:Set(req, out)
end
