--[[--
AudioSpectrumAnalyzer.fuse
DaVinci Resolve / Blackmagic Fusion FFT Audio Spectrum Analyzer Effect Plugin

Supports:
  - WAV formats: PCM 8-bit, 16-bit, 24-bit, 32-bit LE & IEEE Float 32/64-bit LE
    (including WAVE_FORMAT_EXTENSIBLE)
  - Streaming seek-based sample reads (supports multi-GB WAV files safely)
  - True Radix-2 Cooley-Tukey FFT (1024 / 2048 / 4096 / 8192)
  - Logarithmic & Linear frequency mapping + Tilt/Slope compensation
  - Scrubbing-safe deterministic Attack/Release smoothing & Peak Hold
  - 6 Visual Styles: Bars, Segmented LED, Line Curve, Filled Area, Circular Bars, Circular Line
  - 4 Color Modes: Solid, Frequency Gradient, Level Meter, Rainbow
--]]--

FuRegisterClass("AudioSpectrumAnalyzer", CT_Tool, {
    REGS_Name = "Audio Spectrum Analyzer",
    REGS_Category = "Audio",
    REGS_OpIconString = "ASA",
    REGS_OpDescription = "FFT Audio Spectrum Analyzer Graph (WAV)",
    REG_OpNoMask = false,
    REG_NoBlendCtrls = false,
    REG_TimeVariant = true,
    REG_NoPreCalcProcess = true,
    REG_Version = 100,
})

--------------------------------------------------------------------------------
-- Constants & Global Caches (per Fusion instance)
--------------------------------------------------------------------------------
local LN10 = math.log(10.0)
local LN2  = math.log(2.0)
local TWO_PI = 2.0 * math.pi

local WAV_HEADER_CACHE = {}
local FFT_PLAN_CACHE = {}
local SPECTRUM_FRAME_CACHE = {}
local SPECTRUM_CACHE_ORDER = {}
local MAX_FRAME_CACHE = 600

--------------------------------------------------------------------------------
-- Pure Lua Binary / WAV Parsing Utilities (Lua 5.1 / LuaJIT 2.1 / Lua 5.5 safe)
--------------------------------------------------------------------------------
local function read_u16_le(s, pos)
    local b0, b1 = string.byte(s, pos, pos + 1)
    return b0 + b1 * 256
end

local function read_u32_le(s, pos)
    local b0, b1, b2, b3 = string.byte(s, pos, pos + 3)
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
end

local function decode_f32_le(s, pos)
    local b0, b1, b2, b3 = string.byte(s, pos, pos + 3)
    local sign = (b3 >= 128) and -1.0 or 1.0
    local exp = (b3 % 128) * 2 + math.floor(b2 / 128)
    local mant = (b2 % 128) * 65536 + b1 * 256 + b0
    if exp == 0 then
        if mant == 0 then
            return 0.0
        end
        return sign * (mant / 8388608.0) * (2 ^ -126)
    elseif exp == 255 then
        return 0.0
    end
    return sign * (1.0 + mant / 8388608.0) * (2 ^ (exp - 127))
end

local function decode_f64_le(s, pos)
    local b0, b1, b2, b3, b4, b5, b6, b7 = string.byte(s, pos, pos + 7)
    local sign = (b7 >= 128) and -1.0 or 1.0
    local exp = (b7 % 128) * 16 + math.floor(b6 / 16)
    local mant = (b6 % 16) * 281474976710656.0
        + b5 * 1099511627776.0
        + b4 * 4294967296.0
        + b3 * 16777216.0
        + b2 * 65536.0
        + b1 * 256.0
        + b0
    if exp == 0 then
        if mant == 0 then
            return 0.0
        end
        return sign * (mant / 4503599627370496.0) * (2 ^ -1022)
    elseif exp == 2047 then
        return 0.0
    end
    return sign * (1.0 + mant / 4503599627370496.0) * (2 ^ (exp - 1023))
end

local function parse_wav_header(filepath)
    if not filepath or filepath == "" then
        return nil, "No file path"
    end

    local f, err = io.open(filepath, "rb")
    if not f then
        return nil, err or "Cannot open WAV file"
    end

    local file_size = f:seek("end")
    f:seek("set", 0)

    local cached = WAV_HEADER_CACHE[filepath]
    if cached and cached.file_size == file_size then
        f:close()
        return cached
    end

    local riff = f:read(12)
    if not riff or #riff < 12 then
        f:close()
        return nil, "Invalid WAV file (too short)"
    end

    local riff_id = string.sub(riff, 1, 4)
    local wave_id = string.sub(riff, 9, 12)
    if (riff_id ~= "RIFF" and riff_id ~= "RF64") or wave_id ~= "WAVE" then
        f:close()
        return nil, "Not a RIFF/WAVE file"
    end

    local fmt_info = nil
    local data_offset = nil
    local data_bytes = nil
    local ds64_data_size = nil
    local offset = 12

    while offset + 8 <= file_size do
        f:seek("set", offset)
        local chdr = f:read(8)
        if not chdr or #chdr < 8 then
            break
        end
        local cid = string.sub(chdr, 1, 4)
        local csize = read_u32_le(chdr, 5)

        if cid == "ds64" and riff_id == "RF64" and csize >= 24 then
            local dbytes = f:read(24)
            if dbytes and #dbytes >= 16 then
                local lo = read_u32_le(dbytes, 9)
                local hi = read_u32_le(dbytes, 13)
                ds64_data_size = lo + hi * 4294967296.0
            end
        elseif cid == "fmt " then
            local fbytes = f:read(math.min(csize, 64))
            if fbytes and #fbytes >= 16 then
                local audio_fmt = read_u16_le(fbytes, 1)
                local channels = read_u16_le(fbytes, 3)
                local sample_rate = read_u32_le(fbytes, 5)
                local block_align = read_u16_le(fbytes, 13)
                local bits = read_u16_le(fbytes, 15)
                local eff_fmt = audio_fmt
                if audio_fmt == 0xFFFE and #fbytes >= 26 then
                    eff_fmt = read_u16_le(fbytes, 25)
                end
                fmt_info = {
                    audio_format = eff_fmt,
                    channels = channels,
                    sample_rate = sample_rate,
                    block_align = block_align,
                    bits_per_sample = bits,
                }
            end
        elseif cid == "data" then
            data_offset = offset + 8
            local raw_csize = (csize == 4294967295 and ds64_data_size) and ds64_data_size or csize
            data_bytes = math.min(raw_csize, math.max(0, file_size - data_offset))
            if fmt_info then
                break
            end
        end

        local step = 8 + csize + (csize % 2)
        if step < 8 then
            break
        end
        offset = offset + step
    end

    f:close()

    if not fmt_info or not data_offset then
        return nil, "Missing fmt or data chunk"
    end

    if fmt_info.channels < 1 or fmt_info.sample_rate < 1 or fmt_info.block_align < 1 then
        return nil, "Invalid WAV parameters"
    end

    local fmt = fmt_info.audio_format
    local bits = fmt_info.bits_per_sample
    local valid = (fmt == 1 and (bits == 8 or bits == 16 or bits == 24 or bits == 32))
               or (fmt == 3 and (bits == 32 or bits == 64))
    if not valid then
        return nil, string.format("Unsupported WAV encoding (fmt=%d, bits=%d)", fmt, bits)
    end

    local total_samples = math.floor(data_bytes / fmt_info.block_align)
    local info = {
        filepath = filepath,
        file_size = file_size,
        audio_format = fmt,
        channels = fmt_info.channels,
        sample_rate = fmt_info.sample_rate,
        block_align = fmt_info.block_align,
        bits_per_sample = bits,
        data_offset = data_offset,
        data_bytes = data_bytes,
        total_samples = total_samples,
    }
    WAV_HEADER_CACHE[filepath] = info
    return info
end

local function decode_sample_at(buf, pos, fmt, bits)
    if fmt == 1 then
        if bits == 16 then
            local b0, b1 = string.byte(buf, pos, pos + 1)
            local v = b0 + b1 * 256
            if v >= 32768 then v = v - 65536 end
            return v / 32768.0
        elseif bits == 24 then
            local b0, b1, b2 = string.byte(buf, pos, pos + 2)
            local v = b0 + b1 * 256 + b2 * 65536
            if v >= 8388608 then v = v - 16777216 end
            return v / 8388608.0
        elseif bits == 32 then
            local b0, b1, b2, b3 = string.byte(buf, pos, pos + 3)
            local v = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
            if v >= 2147483648 then v = v - 4294967296 end
            return v / 2147483648.0
        elseif bits == 8 then
            return (string.byte(buf, pos) - 128) / 128.0
        end
    elseif fmt == 3 then
        if bits == 32 then
            return decode_f32_le(buf, pos)
        elseif bits == 64 then
            return decode_f64_le(buf, pos)
        end
    end
    return 0.0
end

local function read_wav_window(wav, start_sample, num_samples, channel_mode)
    local out = {}
    for i = 1, num_samples do
        out[i] = 0.0
    end

    if not wav or wav.total_samples <= 0 then
        return out
    end

    local end_sample = start_sample + num_samples - 1
    if end_sample < 0 or start_sample >= wav.total_samples then
        return out
    end

    local read_start = math.max(0, start_sample)
    local read_end = math.min(wav.total_samples - 1, end_sample)
    local read_count = read_end - read_start + 1
    if read_count <= 0 then
        return out
    end

    local f = io.open(wav.filepath, "rb")
    if not f then
        return out
    end

    f:seek("set", wav.data_offset + read_start * wav.block_align)
    local raw = f:read(read_count * wav.block_align)
    f:close()

    if not raw then
        return out
    end

    local actual_frames = math.floor(#raw / wav.block_align)
    local fmt = wav.audio_format
    local bits = wav.bits_per_sample
    local bytes_per_sample = math.floor(bits / 8)
    local ch_count = wav.channels
    local block_align = wav.block_align
    local dst_offset = (read_start - start_sample) + 1

    if ch_count == 1 then
        for i = 0, actual_frames - 1 do
            local pos = i * block_align + 1
            out[dst_offset + i] = decode_sample_at(raw, pos, fmt, bits)
        end
    elseif channel_mode == 1 then
        -- Left
        for i = 0, actual_frames - 1 do
            local pos = i * block_align + 1
            out[dst_offset + i] = decode_sample_at(raw, pos, fmt, bits)
        end
    elseif channel_mode == 2 then
        -- Right
        local ch_off = bytes_per_sample
        for i = 0, actual_frames - 1 do
            local pos = i * block_align + ch_off + 1
            out[dst_offset + i] = decode_sample_at(raw, pos, fmt, bits)
        end
    else
        -- Mix L+R (or all channels)
        if ch_count == 2 then
            for i = 0, actual_frames - 1 do
                local pos = i * block_align + 1
                local l = decode_sample_at(raw, pos, fmt, bits)
                local r = decode_sample_at(raw, pos + bytes_per_sample, fmt, bits)
                out[dst_offset + i] = 0.5 * (l + r)
            end
        else
            local inv_ch = 1.0 / ch_count
            for i = 0, actual_frames - 1 do
                local base = i * block_align + 1
                local acc = 0.0
                for c = 0, ch_count - 1 do
                    acc = acc + decode_sample_at(raw, base + c * bytes_per_sample, fmt, bits)
                end
                out[dst_offset + i] = acc * inv_ch
            end
        end
    end

    return out
end

--------------------------------------------------------------------------------
-- Radix-2 Cooley-Tukey FFT with Cached Plans
--------------------------------------------------------------------------------
local function get_fft_plan(n, window_type)
    local key = tostring(n) .. "_" .. tostring(window_type)
    local cached = FFT_PLAN_CACHE[key]
    if cached then
        return cached
    end

    -- Bit-reversal permutation (1-based indices)
    local bitrev = {}
    local log2n = math.floor(math.log(n) / LN2 + 0.5)
    for i = 0, n - 1 do
        local rev = 0
        local v = i
        for _ = 1, log2n do
            rev = rev * 2 + (v % 2)
            v = math.floor(v / 2)
        end
        bitrev[i + 1] = rev + 1
    end

    -- Window coefficients + coherent gain
    local win = {}
    local win_sum = 0.0
    local denom = n - 1
    for i = 0, n - 1 do
        local x = i / denom
        local w
        if window_type == 1 then
            -- Hamming
            w = 0.54 - 0.46 * math.cos(TWO_PI * x)
        elseif window_type == 2 then
            -- Blackman-Harris
            w = 0.35875
                - 0.48829 * math.cos(TWO_PI * x)
                + 0.14128 * math.cos(2.0 * TWO_PI * x)
                - 0.01168 * math.cos(3.0 * TWO_PI * x)
        else
            -- Hann (default)
            w = 0.5 * (1.0 - math.cos(TWO_PI * x))
        end
        win[i + 1] = w
        win_sum = win_sum + w
    end

    -- Single-sided FFT normalization so 0 dBFS sine wave peaks at ~1.0 (0 dBFS)
    local norm = 2.0 / math.max(win_sum, 1.0)

    -- Precompute stage twiddle tables
    local stages = {}
    local m = 2
    while m <= n do
        local half = m / 2
        local step_angle = -TWO_PI / m
        local wr_tbl = {}
        local wi_tbl = {}
        for j = 0, half - 1 do
            local ang = j * step_angle
            wr_tbl[j + 1] = math.cos(ang)
            wi_tbl[j + 1] = math.sin(ang)
        end
        stages[#stages + 1] = {
            m = m,
            half = half,
            wr = wr_tbl,
            wi = wi_tbl,
        }
        m = m * 2
    end

    local plan = {
        n = n,
        bitrev = bitrev,
        win = win,
        norm = norm,
        stages = stages,
    }
    FFT_PLAN_CACHE[key] = plan
    return plan
end

local function compute_fft_magnitudes(samples, plan)
    local n = plan.n
    local bitrev = plan.bitrev
    local win = plan.win
    local re = {}
    local im = {}

    for i = 1, n do
        local j = bitrev[i]
        re[i] = samples[j] * win[j]
        im[i] = 0.0
    end

    local stages = plan.stages
    for s = 1, #stages do
        local st = stages[s]
        local m = st.m
        local half = st.half
        local wr_tbl = st.wr
        local wi_tbl = st.wi
        for k = 1, n, m do
            for j = 1, half do
                local idx1 = k + j - 1
                local idx2 = idx1 + half
                local wr = wr_tbl[j]
                local wi = wi_tbl[j]
                local tr = wr * re[idx2] - wi * im[idx2]
                local ti = wr * im[idx2] + wi * re[idx2]
                re[idx2] = re[idx1] - tr
                im[idx2] = im[idx1] - ti
                re[idx1] = re[idx1] + tr
                im[idx1] = im[idx1] + ti
            end
        end
    end

    local half_n = math.floor(n / 2)
    local mag = {}
    local norm = plan.norm
    mag[0] = math.sqrt(re[1] * re[1] + im[1] * im[1]) * norm * 0.5
    for k = 1, half_n - 1 do
        local r = re[k + 1]
        local ii = im[k + 1]
        mag[k] = math.sqrt(r * r + ii * ii) * norm
    end
    mag[half_n] = math.sqrt(re[half_n + 1] * re[half_n + 1] + im[half_n + 1] * im[half_n + 1]) * norm * 0.5
    return mag, half_n
end

--------------------------------------------------------------------------------
-- Spectrum Band Calculation + Deterministic Scrubbing-Safe Smoothing
--------------------------------------------------------------------------------
local function compute_raw_bands(wav, frame_idx, params)
    local cache_key = string.format(
        "%s|%d|%d|%d|%d|%.3f|%.4f|%d|%.1f|%.1f|%d|%.2f|%.2f|%.2f",
        wav.filepath,
        wav.file_size,
        frame_idx,
        params.fft_size,
        params.window_type,
        params.fps,
        params.audio_offset,
        params.channel_mode,
        params.min_freq,
        params.max_freq,
        params.num_bands,
        params.freq_scale,
        params.gain_db,
        params.floor_db
    ) .. string.format("|%.2f", params.slope_db)

    local cached = SPECTRUM_FRAME_CACHE[cache_key]
    if cached then
        return cached
    end

    local n = params.fft_size
    local plan = get_fft_plan(n, params.window_type)
    local t_sec = (frame_idx / params.fps) + params.audio_offset
    local center_sample = math.floor(t_sec * wav.sample_rate + 0.5)
    local start_sample = center_sample - math.floor(n / 2)

    local samples = read_wav_window(wav, start_sample, n, params.channel_mode)
    local mag, max_bin = compute_fft_magnitudes(samples, plan)

    local sr = wav.sample_rate
    local nyquist = sr * 0.5
    local f_min = math.max(10.0, math.min(params.min_freq, nyquist * 0.9))
    local f_max = math.max(f_min + 10.0, math.min(params.max_freq, nyquist))
    local num_bands = params.num_bands
    local floor_db = params.floor_db
    local db_range = math.max(6.0, -floor_db)
    local gain_db = params.gain_db
    local slope_db = params.slope_db
    local is_log = (params.freq_scale == 0)
    local freq_ratio = f_max / f_min

    local bands = {}
    for b = 1, num_bands do
        local f0, f1
        if is_log then
            f0 = f_min * (freq_ratio ^ ((b - 1) / num_bands))
            f1 = f_min * (freq_ratio ^ (b / num_bands))
        else
            f0 = f_min + (f_max - f_min) * ((b - 1) / num_bands)
            f1 = f_min + (f_max - f_min) * (b / num_bands)
        end

        local fc = 0.5 * (f0 + f1)
        local b0 = f0 * n / sr
        local b1 = f1 * n / sr
        local amp = 0.0

        if (b1 - b0) < 1.0 then
            -- Sub-bin interpolation for narrow low-frequency bands
            local bc = 0.5 * (b0 + b1)
            local k0 = math.max(0, math.min(max_bin, math.floor(bc)))
            local k1 = math.max(0, math.min(max_bin, k0 + 1))
            local frac = bc - k0
            amp = mag[k0] * (1.0 - frac) + mag[k1] * frac
        else
            local k_start = math.max(0, math.floor(b0))
            local k_end = math.min(max_bin, math.ceil(b1))
            local sum_sq = 0.0
            local peak_v = 0.0
            local count = 0
            for k = k_start, k_end do
                local v = mag[k]
                sum_sq = sum_sq + v * v
                if v > peak_v then
                    peak_v = v
                end
                count = count + 1
            end
            local rms = (count > 0) and math.sqrt(sum_sq / count) or 0.0
            -- Blend RMS and peak so both broadband noise and pure tones display cleanly
            amp = 0.65 * rms + 0.35 * peak_v
        end

        local db = 20.0 * (math.log(math.max(amp, 1e-9)) / LN10)
        local tilt = slope_db * (math.log(math.max(fc, 20.0) / 1000.0) / LN2)
        db = db + gain_db + tilt

        local norm_val = (db - floor_db) / db_range
        if norm_val < 0.0 then norm_val = 0.0 end
        if norm_val > 1.0 then norm_val = 1.0 end
        bands[b] = norm_val
    end

    SPECTRUM_FRAME_CACHE[cache_key] = bands
    SPECTRUM_CACHE_ORDER[#SPECTRUM_CACHE_ORDER + 1] = cache_key
    if #SPECTRUM_CACHE_ORDER > MAX_FRAME_CACHE then
        local old_key = table.remove(SPECTRUM_CACHE_ORDER, 1)
        SPECTRUM_FRAME_CACHE[old_key] = nil
    end

    return bands
end

local function compute_smoothed_spectrum(wav, frame_idx, params)
    local num_bands = params.num_bands
    local attack = params.attack
    local release = params.release
    local peak_decay = params.peak_decay

    -- Determine deterministic lookback window so scrubbing/random seeks match playback
    local max_smooth = math.max(attack, release)
    local lookback = 0
    if max_smooth > 0.01 or params.peak_hold then
        lookback = math.min(24, math.max(8, math.floor(1.0 / math.max(0.04, 1.0 - max_smooth) * 2.5)))
        if params.peak_hold then
            lookback = math.max(lookback, math.min(36, math.ceil(0.6 / math.max(0.01, peak_decay))))
        end
    end

    local start_f = frame_idx - lookback
    local levels = compute_raw_bands(wav, start_f, params)
    local cur = {}
    local peaks = {}
    for b = 1, num_bands do
        cur[b] = levels[b]
        peaks[b] = levels[b]
    end

    for f = start_f + 1, frame_idx do
        local raw = compute_raw_bands(wav, f, params)
        for b = 1, num_bands do
            local target = raw[b]
            local prev = cur[b]
            if target >= prev then
                cur[b] = prev * attack + target * (1.0 - attack)
            else
                cur[b] = prev * release + target * (1.0 - release)
            end

            local pk = peaks[b] - peak_decay
            if cur[b] > pk then
                pk = cur[b]
            end
            if pk < 0.0 then pk = 0.0 end
            peaks[b] = pk
        end
    end

    return cur, peaks
end

--------------------------------------------------------------------------------
-- Color Helpers
--------------------------------------------------------------------------------
local function lerp(a, b, t)
    return a + (b - a) * t
end

local function hsv_to_rgb(h, s, v)
    local i = math.floor(h * 6.0)
    local f = h * 6.0 - i
    local p = v * (1.0 - s)
    local q = v * (1.0 - f * s)
    local t = v * (1.0 - (1.0 - f) * s)
    local m = i % 6
    if m == 0 then return v, t, p
    elseif m == 1 then return q, v, p
    elseif m == 2 then return p, v, t
    elseif m == 3 then return p, q, v
    elseif m == 4 then return t, p, v
    else return v, p, q
    end
end

local function get_band_color(t_freq, color_mode, c1, c2, c3, opacity)
    local r, g, b, a
    if color_mode == 0 then
        r, g, b, a = c1.R, c1.G, c1.B, c1.A
    elseif color_mode == 1 then
        if t_freq <= 0.5 then
            local k = t_freq * 2.0
            r = lerp(c1.R, c2.R, k)
            g = lerp(c1.G, c2.G, k)
            b = lerp(c1.B, c2.B, k)
            a = lerp(c1.A, c2.A, k)
        else
            local k = (t_freq - 0.5) * 2.0
            r = lerp(c2.R, c3.R, k)
            g = lerp(c2.G, c3.G, k)
            b = lerp(c2.B, c3.B, k)
            a = lerp(c2.A, c3.A, k)
        end
    elseif color_mode == 2 then
        -- Level meter default fallback across bands if used as gradient
        if t_freq <= 0.6 then
            local k = t_freq / 0.6
            r = lerp(0.1, 0.95, k)
            g = lerp(0.9, 0.85, k)
            b = lerp(0.35, 0.1, k)
            a = 1.0
        else
            local k = (t_freq - 0.6) / 0.4
            r = lerp(0.95, 1.0, k)
            g = lerp(0.85, 0.15, k)
            b = lerp(0.1, 0.2, k)
            a = 1.0
        end
    else
        r, g, b = hsv_to_rgb((t_freq * 0.82) % 1.0, 0.88, 1.0)
        a = 1.0
    end
    return r, g, b, a * opacity
end

--------------------------------------------------------------------------------
-- Shape Geometry Helpers
--------------------------------------------------------------------------------
local function add_rect_to_shape(sh, x0, y0, x1, y1)
    if x1 <= x0 or y1 <= y0 then
        return
    end
    sh:MoveTo(x0, y0)
    sh:LineTo(x1, y0)
    sh:LineTo(x1, y1)
    sh:LineTo(x0, y1)
    sh:Close()
end

local function add_quad_to_shape(sh, x1, y1, x2, y2, x3, y3, x4, y4)
    sh:MoveTo(x1, y1)
    sh:LineTo(x2, y2)
    sh:LineTo(x3, y3)
    sh:LineTo(x4, y4)
    sh:Close()
end

local function draw_shape(img, sh, r, g, b, a, quality)
    if a <= 0.001 then return end
    local ic = ImageChannel(img, quality)
    local fs = FillStyle()
    local cs = ChannelStyle()
    ic:SetStyleFill(fs)
    ic:ShapeFill(sh)
    cs.Color = Pixel({ R = r, G = g, B = b, A = a })
    ic:PutToImage("CM_Merge", cs)
end

-- Catmull-Rom spline interpolation for smooth spectrum curves
local function sample_catmull_rom(p0, p1, p2, p3, t)
    local t2 = t * t
    local t3 = t2 * t
    return 0.5 * (
        (2.0 * p1) +
        (-p0 + p2) * t +
        (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3) * t2 +
        (-p0 + 3.0 * p1 - 3.0 * p2 + p3) * t3
    )
end

