function OnAddToFlow()
    if self.Comp then
        local ok, prefs = pcall(function() return self.Comp:GetPrefs("Comp.FrameFormat") end)
        if ok and prefs and prefs.Rate and prefs.Rate > 0 then
            InFPS:SetSource(Number(prefs.Rate), 0)
        end
    end
end

function NotifyChanged(inp, param, time)
end

--------------------------------------------------------------------------------
-- Rendering Functions
--------------------------------------------------------------------------------
local function render_grid(out, aspect, style, cx, cy, x0, x1, y_bottom, y_top, y_base, gw, gh, mirror, inner_r, grid_opacity, quality)
    if grid_opacity <= 0.001 then
        return
    end
    local grid_shape = Shape()
    local stroke_w = 0.0012

    if style == 4 or style == 5 then
        local max_r = gh * 0.5
        local rings = { inner_r, inner_r + max_r * 0.5, inner_r + max_r }
        local segs = 72
        for _, r in ipairs(rings) do
            for s = 0, segs do
                local ang = (s / segs) * TWO_PI
                local px = cx + r * math.cos(ang)
                local py = cy + r * math.sin(ang)
                if s == 0 then
                    grid_shape:MoveTo(px, py)
                else
                    grid_shape:LineTo(px, py)
                end
            end
        end
    else
        -- Horizontal dB guide lines (0%, 25%, 50%, 75%, 100%)
        local divs = 4
        for i = 0, divs do
            local gy = y_bottom + (gh * i / divs)
            grid_shape:MoveTo(x0, gy)
            grid_shape:LineTo(x1, gy)
        end
        -- Vertical octave guide lines
        local vdivs = 8
        for i = 0, vdivs do
            local gx = x0 + (gw * i / vdivs)
            grid_shape:MoveTo(gx, y_bottom)
            grid_shape:LineTo(gx, y_top)
        end
        if mirror then
            grid_shape:MoveTo(x0, y_base)
            grid_shape:LineTo(x1, y_base)
        end
    end

    local outlined = grid_shape:OutlineOfShape(stroke_w, "OLT_Solid")
    draw_shape(out, outlined, 0.85, 0.9, 1.0, grid_opacity * 0.65, quality)
end

local function render_spectrum(out, levels, peaks, opts)
    local aspect = (out.Height * out.YScale) / (out.Width * out.XScale)
    local quality = opts.quick and 4 or 8

    local cx = opts.center_x
    local cy = opts.center_y * aspect
    local gw = opts.graph_w
    local gh = opts.graph_h * aspect
    local x0 = cx - gw * 0.5
    local x1 = cx + gw * 0.5
    local y_bottom = cy - gh * 0.5
    local y_top = cy + gh * 0.5
    local mirror = opts.mirror
    local y_base = mirror and cy or y_bottom
    local max_h = mirror and (gh * 0.5) or gh

    -- Optional tinted backdrop
    if opts.bg_opacity > 0.001 then
        local bg_shape = Shape()
        add_rect_to_shape(bg_shape, -0.01, -0.01, 1.01, aspect + 0.01)
        draw_shape(out, bg_shape, opts.bg.R, opts.bg.G, opts.bg.B, opts.bg.A * opts.bg_opacity, 4)
    end

    -- Optional Grid & Baseline
    if opts.show_grid then
        render_grid(out, aspect, opts.style, cx, cy, x0, x1, y_bottom, y_top, y_base, gw, gh, mirror, opts.inner_r, opts.grid_opacity, quality)
    end

    local num_bands = #levels
    local style = opts.style
    local color_mode = opts.color_mode
    local c1, c2, c3, c_peak = opts.c1, opts.c2, opts.c3, opts.c_peak
    local opacity = opts.opacity
    local halo = opts.halo
    local gap = opts.bar_gap
    local line_w = opts.line_w

    ----------------------------------------------------------------------------
    -- Style 0: Bars
    ----------------------------------------------------------------------------
    if style == 0 then
        local slot_w = gw / num_bands
        local bar_w = math.max(0.0008, slot_w * (1.0 - gap))
        local min_h = 0.0015 * aspect

        if color_mode == 0 then
            local sh = Shape()
            local halo_sh = (halo > 0.01) and Shape() or nil
            for i = 1, num_bands do
                local bx0 = x0 + (i - 0.5) * slot_w - bar_w * 0.5
                local bx1 = bx0 + bar_w
                local bh = math.max(levels[i] * max_h, min_h)
                if mirror then
                    add_rect_to_shape(sh, bx0, cy - bh, bx1, cy + bh)
                    if halo_sh then
                        local pad = bar_w * 0.35
                        add_rect_to_shape(halo_sh, bx0 - pad, cy - bh - pad, bx1 + pad, cy + bh + pad)
                    end
                else
                    add_rect_to_shape(sh, bx0, y_bottom, bx1, y_bottom + bh)
                    if halo_sh then
                        local pad = bar_w * 0.35
                        add_rect_to_shape(halo_sh, bx0 - pad, y_bottom, bx1 + pad, y_bottom + bh + pad)
                    end
                end
            end
            if halo_sh then
                draw_shape(out, halo_sh, c1.R, c1.G, c1.B, c1.A * opacity * 0.22 * halo, quality)
            end
            draw_shape(out, sh, c1.R, c1.G, c1.B, c1.A * opacity, quality)
        else
            -- Bucket colors into <= 24 passes for speed + smooth gradients
            local buckets = math.min(num_bands, 24)
            local bucket_shapes = {}
            local halo_shapes = (halo > 0.01) and {} or nil
            for k = 1, buckets do
                bucket_shapes[k] = Shape()
                if halo_shapes then halo_shapes[k] = Shape() end
            end

            for i = 1, num_bands do
                local t_freq = (num_bands > 1) and ((i - 1) / (num_bands - 1)) or 0.0
                local t_color = (color_mode == 2) and levels[i] or t_freq
                local b_idx = math.max(1, math.min(buckets, math.floor(t_color * (buckets - 1) + 0.5) + 1))

                local bx0 = x0 + (i - 0.5) * slot_w - bar_w * 0.5
                local bx1 = bx0 + bar_w
                local bh = math.max(levels[i] * max_h, min_h)
                if mirror then
                    add_rect_to_shape(bucket_shapes[b_idx], bx0, cy - bh, bx1, cy + bh)
                    if halo_shapes then
                        local pad = bar_w * 0.35
                        add_rect_to_shape(halo_shapes[b_idx], bx0 - pad, cy - bh - pad, bx1 + pad, cy + bh + pad)
                    end
                else
                    add_rect_to_shape(bucket_shapes[b_idx], bx0, y_bottom, bx1, y_bottom + bh)
                    if halo_shapes then
                        local pad = bar_w * 0.35
                        add_rect_to_shape(halo_shapes[b_idx], bx0 - pad, y_bottom, bx1 + pad, y_bottom + bh + pad)
                    end
                end
            end

            for k = 1, buckets do
                local tk = (buckets > 1) and ((k - 1) / (buckets - 1)) or 0.0
                local r, g, b, a = get_band_color(tk, color_mode, c1, c2, c3, opacity)
                if halo_shapes then
                    draw_shape(out, halo_shapes[k], r, g, b, a * 0.22 * halo, quality)
                end
                draw_shape(out, bucket_shapes[k], r, g, b, a, quality)
            end
        end

        if opts.peak_hold then
            local psh = Shape()
            local cap_h = math.max(line_w, 0.002 * aspect)
            for i = 1, num_bands do
                local bx0 = x0 + (i - 0.5) * slot_w - bar_w * 0.5
                local bx1 = bx0 + bar_w
                local ph = peaks[i] * max_h
                if mirror then
                    add_rect_to_shape(psh, bx0, cy + ph, bx1, cy + ph + cap_h)
                    add_rect_to_shape(psh, bx0, cy - ph - cap_h, bx1, cy - ph)
                else
                    add_rect_to_shape(psh, bx0, y_bottom + ph, bx1, y_bottom + ph + cap_h)
                end
            end
            draw_shape(out, psh, c_peak.R, c_peak.G, c_peak.B, c_peak.A * opacity, quality)
        end

    ----------------------------------------------------------------------------
    -- Style 1: Segmented LED
    ----------------------------------------------------------------------------
    elseif style == 1 then
        local slot_w = gw / num_bands
        local bar_w = math.max(0.0008, slot_w * (1.0 - gap))
        local n_segs = opts.led_segments
        local seg_slot = max_h / n_segs
        local seg_h = seg_slot * 0.72

        if color_mode == 2 then
            -- Classic 3-zone LED Meter: Green -> Yellow -> Red
            local sh_low = Shape()
            local sh_mid = Shape()
            local sh_high = Shape()
            for i = 1, num_bands do
                local bx0 = x0 + (i - 0.5) * slot_w - bar_w * 0.5
                local bx1 = bx0 + bar_w
                local lit = math.floor(levels[i] * n_segs + 0.5)
                for s = 1, lit do
                    local frac = s / n_segs
                    local target = (frac <= 0.60) and sh_low or ((frac <= 0.84) and sh_mid or sh_high)
                    local sy0 = (s - 1) * seg_slot
                    local sy1 = sy0 + seg_h
                    if mirror then
                        add_rect_to_shape(target, bx0, cy + sy0, bx1, cy + sy1)
                        add_rect_to_shape(target, bx0, cy - sy1, bx1, cy - sy0)
                    else
                        add_rect_to_shape(target, bx0, y_bottom + sy0, bx1, y_bottom + sy1)
                    end
                end
            end
            draw_shape(out, sh_low, 0.12, 0.92, 0.42, opacity, quality)
            draw_shape(out, sh_mid, 1.00, 0.82, 0.12, opacity, quality)
            draw_shape(out, sh_high, 1.00, 0.18, 0.25, opacity, quality)
        else
            local buckets = math.min(num_bands, 24)
            local bucket_shapes = {}
            for k = 1, buckets do bucket_shapes[k] = Shape() end

            for i = 1, num_bands do
                local t_freq = (num_bands > 1) and ((i - 1) / (num_bands - 1)) or 0.0
                local b_idx = (color_mode == 0) and 1 or math.max(1, math.min(buckets, math.floor(t_freq * (buckets - 1) + 0.5) + 1))
                local bx0 = x0 + (i - 0.5) * slot_w - bar_w * 0.5
                local bx1 = bx0 + bar_w
                local lit = math.floor(levels[i] * n_segs + 0.5)
                for s = 1, lit do
                    local sy0 = (s - 1) * seg_slot
                    local sy1 = sy0 + seg_h
                    if mirror then
                        add_rect_to_shape(bucket_shapes[b_idx], bx0, cy + sy0, bx1, cy + sy1)
                        add_rect_to_shape(bucket_shapes[b_idx], bx0, cy - sy1, bx1, cy - sy0)
                    else
                        add_rect_to_shape(bucket_shapes[b_idx], bx0, y_bottom + sy0, bx1, y_bottom + sy1)
                    end
                end
            end
            for k = 1, (color_mode == 0 and 1 or buckets) do
                local tk = (buckets > 1) and ((k - 1) / (buckets - 1)) or 0.0
                local r, g, b, a = get_band_color(tk, color_mode, c1, c2, c3, opacity)
                draw_shape(out, bucket_shapes[k], r, g, b, a, quality)
            end
        end

        if opts.peak_hold then
            local psh = Shape()
            for i = 1, num_bands do
                local bx0 = x0 + (i - 0.5) * slot_w - bar_w * 0.5
                local bx1 = bx0 + bar_w
                local pk_seg = math.max(1, math.min(n_segs, math.floor(peaks[i] * n_segs + 0.5)))
                if peaks[i] > 0.005 then
                    local sy0 = (pk_seg - 1) * seg_slot
                    local sy1 = sy0 + seg_h
                    if mirror then
                        add_rect_to_shape(psh, bx0, cy + sy0, bx1, cy + sy1)
                        add_rect_to_shape(psh, bx0, cy - sy1, bx1, cy - sy0)
                    else
                        add_rect_to_shape(psh, bx0, y_bottom + sy0, bx1, y_bottom + sy1)
                    end
                end
            end
            draw_shape(out, psh, c_peak.R, c_peak.G, c_peak.B, c_peak.A * opacity, quality)
        end

    ----------------------------------------------------------------------------
    -- Style 2 (Line Curve) & Style 3 (Filled Area)
    ----------------------------------------------------------------------------
    elseif style == 2 or style == 3 then
        local pts_x = {}
        local pts_y = {}
        for i = 1, num_bands do
            local tx = (num_bands > 1) and ((i - 1) / (num_bands - 1)) or 0.5
            pts_x[i] = x0 + tx * gw
            pts_y[i] = levels[i] * max_h
        end

        local subdiv = 3
        local smooth_x = {}
        local smooth_y = {}
        for i = 1, num_bands - 1 do
            local p0 = pts_y[math.max(1, i - 1)]
            local p1 = pts_y[i]
            local p2 = pts_y[i + 1]
            local p3 = pts_y[math.min(num_bands, i + 2)]
            for s = 0, subdiv - 1 do
                local t = s / subdiv
                smooth_x[#smooth_x + 1] = lerp(pts_x[i], pts_x[i + 1], t)
                local sy = sample_catmull_rom(p0, p1, p2, p3, t)
                if sy < 0.0 then sy = 0.0 end
                if sy > max_h then sy = max_h end
                smooth_y[#smooth_y + 1] = sy
            end
        end
        smooth_x[#smooth_x + 1] = pts_x[num_bands]
        smooth_y[#smooth_y + 1] = pts_y[num_bands]

        if color_mode == 0 then
            local r_main, g_main, b_main, a_main = c1.R, c1.G, c1.B, c1.A * opacity
            if style == 3 then
                local fill_sh = Shape()
                fill_sh:MoveTo(smooth_x[1], y_base)
                for k = 1, #smooth_x do
                    fill_sh:LineTo(smooth_x[k], y_base + smooth_y[k])
                end
                fill_sh:LineTo(smooth_x[#smooth_x], y_base)
                fill_sh:Close()

                if mirror then
                    fill_sh:MoveTo(smooth_x[1], y_base)
                    for k = 1, #smooth_x do
                        fill_sh:LineTo(smooth_x[k], y_base - smooth_y[k])
                    end
                    fill_sh:LineTo(smooth_x[#smooth_x], y_base)
                    fill_sh:Close()
                end
                draw_shape(out, fill_sh, r_main, g_main, b_main, a_main * 0.42, quality)
            end

            local line_sh = Shape()
            line_sh:MoveTo(smooth_x[1], y_base + smooth_y[1])
            for k = 2, #smooth_x do
                line_sh:LineTo(smooth_x[k], y_base + smooth_y[k])
            end
            if mirror then
                line_sh:MoveTo(smooth_x[1], y_base - smooth_y[1])
                for k = 2, #smooth_x do
                    line_sh:LineTo(smooth_x[k], y_base - smooth_y[k])
                end
            end

            if halo > 0.01 then
                local halo_out = line_sh:OutlineOfShape(line_w * 3.2, "OLT_Solid")
                draw_shape(out, halo_out, r_main, g_main, b_main, a_main * 0.25 * halo, quality)
            end
            local line_out = line_sh:OutlineOfShape(line_w, "OLT_Solid")
            draw_shape(out, line_out, c_peak.R * 0.3 + r_main * 0.7, c_peak.G * 0.3 + g_main * 0.7, c_peak.B * 0.3 + b_main * 0.7, a_main, quality)
        else
            local total_pts = #smooth_x
            local buckets = math.min(num_bands, 24)
            for b = 1, buckets do
                local i_start = math.max(1, math.floor(((b - 1) / buckets) * (total_pts - 1)) + 1)
                local i_end = math.min(total_pts, math.floor((b / buckets) * (total_pts - 1)) + 1)
                if i_end > i_start then
                    local mid_k = math.floor((i_start + i_end) * 0.5)
                    local t_freq = (total_pts > 1) and ((mid_k - 1) / (total_pts - 1)) or 0.0
                    local t_color = (color_mode == 2 and max_h > 0) and (smooth_y[mid_k] / max_h) or t_freq
                    local r_b, g_b, b_b, a_b = get_band_color(t_color, color_mode, c1, c2, c3, opacity)

                    if style == 3 then
                        local fill_sh = Shape()
                        fill_sh:MoveTo(smooth_x[i_start], y_base)
                        for k = i_start, i_end do
                            fill_sh:LineTo(smooth_x[k], y_base + smooth_y[k])
                        end
                        fill_sh:LineTo(smooth_x[i_end], y_base)
                        fill_sh:Close()

                        if mirror then
                            fill_sh:MoveTo(smooth_x[i_start], y_base)
                            for k = i_start, i_end do
                                fill_sh:LineTo(smooth_x[k], y_base - smooth_y[k])
                            end
                            fill_sh:LineTo(smooth_x[i_end], y_base)
                            fill_sh:Close()
                        end
                        draw_shape(out, fill_sh, r_b, g_b, b_b, a_b * 0.42, quality)
                    end

                    local seg_sh = Shape()
                    seg_sh:MoveTo(smooth_x[i_start], y_base + smooth_y[i_start])
                    for k = i_start + 1, i_end do
                        seg_sh:LineTo(smooth_x[k], y_base + smooth_y[k])
                    end
                    if mirror then
                        seg_sh:MoveTo(smooth_x[i_start], y_base - smooth_y[i_start])
                        for k = i_start + 1, i_end do
                            seg_sh:LineTo(smooth_x[k], y_base - smooth_y[k])
                        end
                    end
                    if halo > 0.01 then
                        draw_shape(out, seg_sh:OutlineOfShape(line_w * 3.2, "OLT_Solid"), r_b, g_b, b_b, a_b * 0.25 * halo, quality)
                    end
                    draw_shape(out, seg_sh:OutlineOfShape(line_w, "OLT_Solid"), c_peak.R * 0.25 + r_b * 0.75, c_peak.G * 0.25 + g_b * 0.75, c_peak.B * 0.25 + b_b * 0.75, a_b, quality)
                end
            end
        end

    ----------------------------------------------------------------------------
    -- Style 4: Circular Bars
    ----------------------------------------------------------------------------
    elseif style == 4 then
        local rot_rad = (opts.rotation * math.pi) / 180.0
        local base_r = opts.inner_r
        local max_r = gh * 0.5
        local angular_slot = TWO_PI / num_bands
        local half_ang = angular_slot * (1.0 - gap) * 0.5
        local buckets = (color_mode == 0) and 1 or math.min(num_bands, 24)
        local bucket_shapes = {}
        local halo_shapes = (halo > 0.01) and {} or nil
        for k = 1, buckets do
            bucket_shapes[k] = Shape()
            if halo_shapes then halo_shapes[k] = Shape() end
        end

        for i = 1, num_bands do
            local t_freq = (num_bands > 1) and ((i - 1) / (num_bands - 1)) or 0.0
            local t_color = (color_mode == 2) and levels[i] or t_freq
            local b_idx = (color_mode == 0) and 1 or math.max(1, math.min(buckets, math.floor(t_color * (buckets - 1) + 0.5) + 1))

            local theta = rot_rad + (i - 1) * angular_slot
            local a0 = theta - half_ang
            local a1 = theta + half_ang
            local c0, s0 = math.cos(a0), math.sin(a0)
            local c1a, s1a = math.cos(a1), math.sin(a1)

            local r_out = base_r + math.max(levels[i] * max_r, 0.002)
            local r_in = mirror and math.max(0.005, base_r - levels[i] * max_r * 0.45) or base_r

            add_quad_to_shape(
                bucket_shapes[b_idx],
                cx + r_in * c0, cy + r_in * s0,
                cx + r_out * c0, cy + r_out * s0,
                cx + r_out * c1a, cy + r_out * s1a,
                cx + r_in * c1a, cy + r_in * s1a
            )

            if halo_shapes then
                local pad = half_ang * 0.35
                local hc0, hs0 = math.cos(a0 - pad), math.sin(a0 - pad)
                local hc1, hs1 = math.cos(a1 + pad), math.sin(a1 + pad)
                add_quad_to_shape(
                    halo_shapes[b_idx],
                    cx + r_in * hc0, cy + r_in * hs0,
                    cx + (r_out + 0.006) * hc0, cy + (r_out + 0.006) * hs0,
                    cx + (r_out + 0.006) * hc1, cy + (r_out + 0.006) * hs1,
                    cx + r_in * hc1, cy + r_in * hs1
                )
            end
        end

        for k = 1, buckets do
            local tk = (buckets > 1) and ((k - 1) / (buckets - 1)) or 0.0
            local r, g, b, a = get_band_color(tk, color_mode, c1, c2, c3, opacity)
            if halo_shapes then
                draw_shape(out, halo_shapes[k], r, g, b, a * 0.22 * halo, quality)
            end
            draw_shape(out, bucket_shapes[k], r, g, b, a, quality)
        end

        if opts.peak_hold then
            local psh = Shape()
            local cap_r = math.max(line_w, 0.0025)
            for i = 1, num_bands do
                local theta = rot_rad + (i - 1) * angular_slot
                local a0 = theta - half_ang
                local a1 = theta + half_ang
                local rp0 = base_r + peaks[i] * max_r
                local rp1 = rp0 + cap_r
                add_quad_to_shape(
                    psh,
                    cx + rp0 * math.cos(a0), cy + rp0 * math.sin(a0),
                    cx + rp1 * math.cos(a0), cy + rp1 * math.sin(a0),
                    cx + rp1 * math.cos(a1), cy + rp1 * math.sin(a1),
                    cx + rp0 * math.cos(a1), cy + rp0 * math.sin(a1)
                )
            end
            draw_shape(out, psh, c_peak.R, c_peak.G, c_peak.B, c_peak.A * opacity, quality)
        end

    ----------------------------------------------------------------------------
    -- Style 5: Circular Line
    ----------------------------------------------------------------------------
    elseif style == 5 then
        local rot_rad = (opts.rotation * math.pi) / 180.0
        local base_r = opts.inner_r
        local max_r = gh * 0.5
        local angular_slot = TWO_PI / num_bands
        local subdiv = 3

        local outer_x = {}
        local outer_y = {}
        local outer_val = {}
        local inner_x = mirror and {} or nil
        local inner_y = mirror and {} or nil

        for i = 1, num_bands do
            local i0 = ((i - 2) % num_bands) + 1
            local i1 = i
            local i2 = (i % num_bands) + 1
            local i3 = ((i + 1) % num_bands) + 1
            local base_ang = rot_rad + (i - 1) * angular_slot

            for s = 0, subdiv - 1 do
                local t = s / subdiv
                local val = sample_catmull_rom(levels[i0], levels[i1], levels[i2], levels[i3], t)
                if val < 0.0 then val = 0.0 end
                if val > 1.0 then val = 1.0 end
                local ang = base_ang + t * angular_slot
                local ca, sa = math.cos(ang), math.sin(ang)

                local r_out = base_r + val * max_r
                outer_x[#outer_x + 1] = cx + r_out * ca
                outer_y[#outer_y + 1] = cy + r_out * sa
                outer_val[#outer_val + 1] = val

                if inner_x then
                    local r_in = math.max(0.005, base_r - val * max_r * 0.45)
                    inner_x[#inner_x + 1] = cx + r_in * ca
                    inner_y[#inner_y + 1] = cy + r_in * sa
                end
            end
        end

        local outer_sh = Shape()
        outer_sh:MoveTo(outer_x[1], outer_y[1])
        for k = 2, #outer_x do
            outer_sh:LineTo(outer_x[k], outer_y[k])
        end
        outer_sh:LineTo(outer_x[1], outer_y[1])
        outer_sh:Close()

        local r_main, g_main, b_main, a_main
        if color_mode == 0 then
            r_main, g_main, b_main, a_main = c1.R, c1.G, c1.B, c1.A * opacity
        else
            r_main, g_main, b_main, a_main = get_band_color(0.35, 1, c1, c2, c3, opacity)
        end

        -- Subtle inner glow fill
        draw_shape(out, outer_sh, r_main, g_main, b_main, a_main * 0.16, quality)

        if color_mode == 0 then
            if halo > 0.01 then
                draw_shape(out, outer_sh:OutlineOfShape(line_w * 3.0, "OLT_Solid"), r_main, g_main, b_main, a_main * 0.25 * halo, quality)
            end
            draw_shape(out, outer_sh:OutlineOfShape(line_w, "OLT_Solid"), r_main, g_main, b_main, a_main, quality)
        else
            local total_pts = #outer_x
            local buckets = math.min(num_bands, 24)
            for b = 1, buckets do
                local i_start = math.max(1, math.floor(((b - 1) / buckets) * total_pts) + 1)
                local i_end = math.min(total_pts + 1, math.floor((b / buckets) * total_pts) + 1)
                if i_end > i_start then
                    local mid_k = math.min(total_pts, math.floor((i_start + i_end) * 0.5))
                    local t_freq = (total_pts > 1) and ((mid_k - 1) / total_pts) or 0.0
                    local t_color = (color_mode == 2) and outer_val[mid_k] or t_freq
                    local r_b, g_b, b_b, a_b = get_band_color(t_color, color_mode, c1, c2, c3, opacity)

                    local seg_sh = Shape()
                    seg_sh:MoveTo(outer_x[i_start], outer_y[i_start])
                    for k = i_start + 1, i_end do
                        local kk = ((k - 1) % total_pts) + 1
                        seg_sh:LineTo(outer_x[kk], outer_y[kk])
                    end
                    if halo > 0.01 then
                        draw_shape(out, seg_sh:OutlineOfShape(line_w * 3.0, "OLT_Solid"), r_b, g_b, b_b, a_b * 0.25 * halo, quality)
                    end
                    draw_shape(out, seg_sh:OutlineOfShape(line_w, "OLT_Solid"), r_b, g_b, b_b, a_b, quality)
                end
            end
        end

        if inner_x then
            local inner_sh = Shape()
            inner_sh:MoveTo(inner_x[1], inner_y[1])
            for k = 2, #inner_x do
                inner_sh:LineTo(inner_x[k], inner_y[k])
            end
            inner_sh:LineTo(inner_x[1], inner_y[1])
            inner_sh:Close()
            draw_shape(out, inner_sh:OutlineOfShape(line_w, "OLT_Solid"), c2.R, c2.G, c2.B, a_main * 0.85, quality)
        end
    end
end

function Process(req)
    local in_img = InImage:GetValue(req)
    local out_w, out_h, xscale, yscale
    local prefs = nil
    if self.Comp then
        local ok, res = pcall(function() return self.Comp:GetPrefs("Comp.FrameFormat") end)
        if ok then prefs = res end
    end

    if in_img then
        out_w = in_img.Width
        out_h = in_img.Height
        xscale = in_img.XScale
        yscale = in_img.YScale
    else
        local fb_w = math.floor(InOutWidth:GetValue(req).Value + 0.5)
        local fb_h = math.floor(InOutHeight:GetValue(req).Value + 0.5)
        out_w = (prefs and prefs.Width) or fb_w
        out_h = (prefs and prefs.Height) or fb_h
        xscale = (prefs and prefs.XAspect) or 1.0
        yscale = (prefs and prefs.YAspect) or 1.0
        if req:IsQuick() then
            out_w = math.max(64, math.floor(out_w * 0.5))
            out_h = math.max(64, math.floor(out_h * 0.5))
        end
    end

    if req:IsPreCalc() then
        local pre_out = Image({
            IMG_Document = self.Comp,
            IMG_Width = out_w,
            IMG_Height = out_h,
            IMG_XScale = xscale,
            IMG_YScale = yscale,
            IMG_NoData = true,
        })
        OutImage:Set(req, pre_out)
        return
    end

    local composite = (InComposite:GetValue(req).Value > 0.5)
    local out
    if in_img and composite then
        out = in_img:CopyOf()
    elseif in_img then
        out = Image({ IMG_Like = in_img })
        out:Fill(Pixel({ R = 0, G = 0, B = 0, A = 0 }))
    else
        out = Image({
            IMG_Document = self.Comp,
            IMG_Width = out_w,
            IMG_Height = out_h,
            IMG_XScale = xscale,
            IMG_YScale = yscale,
            { IMG_Channel = "Red" },
            { IMG_Channel = "Green" },
            { IMG_Channel = "Blue" },
            { IMG_Channel = "Alpha" },
        })
        out:Fill(Pixel({ R = 0, G = 0, B = 0, A = 0 }))
    end

    local filepath = InAudioFile:GetValue(req).Value
    local num_bands = math.max(8, math.min(128, math.floor(InBands:GetValue(req).Value + 0.5)))
    local fft_idx = math.floor(InFFTSize:GetValue(req).Value + 0.5)
    local fft_sizes = { [0] = 1024, [1] = 2048, [2] = 4096, [3] = 8192 }
    local fft_size = fft_sizes[fft_idx] or 4096

    local auto_fps = (InAutoFPS:GetValue(req).Value > 0.5)
    local manual_fps = InFPS:GetValue(req).Value
    local eff_fps = (auto_fps and prefs and prefs.Rate and prefs.Rate > 0) and prefs.Rate or manual_fps

    local peak_hold = (InPeakHold:GetValue(req).Value > 0.5)
    local params = {
        fft_size = fft_size,
        window_type = math.floor(InWindowType:GetValue(req).Value + 0.5),
        freq_scale = math.floor(InFreqScale:GetValue(req).Value + 0.5),
        fps = math.max(1.0, eff_fps),
        audio_offset = InAudioOffset:GetValue(req).Value,
        channel_mode = math.floor(InChannel:GetValue(req).Value + 0.5),
        min_freq = InMinFreq:GetValue(req).Value,
        max_freq = InMaxFreq:GetValue(req).Value,
        num_bands = num_bands,
        gain_db = InGainDB:GetValue(req).Value,
        floor_db = InFloorDB:GetValue(req).Value,
        slope_db = InSlope:GetValue(req).Value,
        attack = InAttack:GetValue(req).Value,
        release = InRelease:GetValue(req).Value,
        peak_decay = InPeakDecay:GetValue(req).Value,
        peak_hold = peak_hold,
    }

    local levels = {}
    local peaks = {}
    for b = 1, num_bands do
        levels[b] = 0.0
        peaks[b] = 0.0
    end

    local wav, wav_err = parse_wav_header(filepath)
    if wav then
        levels, peaks = compute_smoothed_spectrum(wav, math.floor(req.Time + 0.5), params)
    elseif filepath and filepath ~= "" and wav_err then
        -- Non-fatal log so user can diagnose path/format in Fusion Console
        print("[AudioSpectrumAnalyzer] " .. tostring(wav_err) .. " (" .. tostring(filepath) .. ")")
    end

    local center = InCenter:GetValue(req)
    local opts = {
        quick = req:IsQuick(),
        style = math.floor(InStyle:GetValue(req).Value + 0.5),
        mirror = (InMirror:GetValue(req).Value > 0.5),
        peak_hold = peak_hold,
        center_x = center.X,
        center_y = center.Y,
        graph_w = InGraphWidth:GetValue(req).Value,
        graph_h = InGraphHeight:GetValue(req).Value,
        bar_gap = InBarGap:GetValue(req).Value,
        line_w = InLineWidth:GetValue(req).Value,
        inner_r = InInnerRadius:GetValue(req).Value,
        rotation = InRotation:GetValue(req).Value,
        show_grid = (InShowGrid:GetValue(req).Value > 0.5),
        grid_opacity = InGridOpacity:GetValue(req).Value,
        bg_opacity = InBgOpacity:GetValue(req).Value,
        bg = {
            R = InBgR:GetValue(req).Value,
            G = InBgG:GetValue(req).Value,
            B = InBgB:GetValue(req).Value,
            A = InBgA:GetValue(req).Value,
        },
        color_mode = math.floor(InColorMode:GetValue(req).Value + 0.5),
        c1 = {
            R = InColor1R:GetValue(req).Value,
            G = InColor1G:GetValue(req).Value,
            B = InColor1B:GetValue(req).Value,
            A = InColor1A:GetValue(req).Value,
        },
        c2 = {
            R = InColor2R:GetValue(req).Value,
            G = InColor2G:GetValue(req).Value,
            B = InColor2B:GetValue(req).Value,
            A = InColor2A:GetValue(req).Value,
        },
        c3 = {
            R = InColor3R:GetValue(req).Value,
            G = InColor3G:GetValue(req).Value,
            B = InColor3B:GetValue(req).Value,
            A = InColor3A:GetValue(req).Value,
        },
        c_peak = {
            R = InPeakR:GetValue(req).Value,
            G = InPeakG:GetValue(req).Value,
            B = InPeakB:GetValue(req).Value,
            A = InPeakA:GetValue(req).Value,
        },
        led_segments = math.max(4, math.min(48, math.floor(InLedSegments:GetValue(req).Value + 0.5))),
        halo = InHaloGlow:GetValue(req).Value,
        opacity = InSpectrumOpacity:GetValue(req).Value,
    }

    render_spectrum(out, levels, peaks, opts)
    OutImage:Set(req, out)
end
